{
  "manifest_version": 3,
  "name": "Indeed CV Downloader",
  "version": "3.9",
  "description": "Downloads Indeed resumes into Google Drive, sharing one team-wide record of who has already been downloaded.",
  "key": "",
  "action": {
    "default_title": "Run Indeed CV Downloader (to Google Drive)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "storage",
    "identity",
    "contextMenus"
  ],
  "host_permissions": [
    "https://employers.indeed.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "276076835083-714s1k0lm5tbppam4g50ol2rdfqp1989.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "update_url": "https://juanroldangg.github.io/indeed-cv-downloader/updates.xml"
}
